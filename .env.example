# Smarter Way to Shop — Environment Variables
# RG Digital Labs, LLC · Sept 2026
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.

# -- Supabase (shared project with Smart Kitchen and Smart Cellar) ------------
VITE_SUPABASE_URL=https://wnlqvmedocpgjawmwivd.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -- Anthropic (SERVER-ONLY: used by api/ai.js; never prefix this with VITE_ or NEXT_PUBLIC_) --
#    Anything starting with VITE_ is copied into the public website code where anyone can read it.
ANTHROPIC_API_KEY=your_swts_server_anthropic_key_here
# Optional: AI_MODEL (default claude-sonnet-4-6), AI_USER_LIMIT_PER_HOUR (default 300), AI_ALL_PER_DAY (default 4000)
# Also needed by api/ai.js (already used by the Stripe webhook): SUPABASE_SERVICE_ROLE_KEY, VITE_SUPABASE_URL
# -- Stripe (shared live account with Smart Kitchen and Smart Cellar) --------
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_live_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here   # server-side only (Vercel env)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here   # server-side only

# -- SWTS Stripe Price IDs (already created in Stripe, Aug 2026) -------------
# Suite-member rate (for users who already have an active Smart Kitchen tier)
STRIPE_PRICE_SWS_ADDON_MONTHLY=price_1UAXxQPPshJUzsYX4Bn4nroX
STRIPE_PRICE_SWS_ADDON_ANNUAL=price_1UAXxYPPshJUzsYXglzsb3nr
# Standalone rate (for users with no Smart Kitchen subscription)
STRIPE_PRICE_SWS_STANDALONE_MONTHLY=price_1UAbjZPPshJUzsYXpKmXiLGC
STRIPE_PRICE_SWS_STANDALONE_ANNUAL=price_1UAbjpPPshJUzsYXlPTqXsuK

# -- App URLs ------------------------------------------------------------------
VITE_APP_URL=https://smarter-way-to-shop.vercel.app          # update after Vercel deploy
VITE_SMART_KITCHEN_URL=https://smart-kitchen-opal.vercel.app
